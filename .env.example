# Copy this file to .env and fill in the three values below.
#
#   cp .env.example .env
#
# Nothing here was filled in for you, deliberately. The cluster you built during the quest
# was temporary and its credentials are not yours to keep — and a repo in your account is
# not a place secrets should arrive by default.

# ── Required ────────────────────────────────────────────────────────────────────────
# Your own Atlas cluster. Free tier is plenty: https://mongodb.com/atlas
# Atlas → Connect → Drivers gives you this string. Replace <password> with the real one.
MONGODB_URI=mongodb+srv://USER:PASSWORD@YOUR-CLUSTER.mongodb.net/?retryWrites=true&w=majority

# Embeddings. Free tier at https://voyageai.com
VOYAGE_API_KEY=

# ── Optional ────────────────────────────────────────────────────────────────────────
# Without a key the agent still runs and still retrieves — it prints what it found instead
# of writing prose about it. Add one when you want it to talk back.
#
# Any OpenAI-compatible endpoint works. For a local model:
#   LLM_BASE_URL=http://localhost:11434/v1
#   LLM_API_KEY=ollama
#   LLM_MODEL=llama3.2
LLM_API_KEY=
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-5.6-luna

# Overrides the database name baked into agent.config.json.
# DB_NAME=quests-a7640941cf2c45eaa695aefb
